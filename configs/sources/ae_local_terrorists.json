{
  "source_id": "ae_local_terrorists",
  "agency": "UAE Government",
  "list_name": "Local Terrorist List",
  "country": "AE",
  "engine": "file_download",
  "format": "csv",
  "encoding": "utf-8",
  "delimiter": ",",
  "has_header": true,
  "field_map": {
    "name": "name",
    "date_of_birth": "birth_date",
    "address": "addresses",
    "details": "schema,aliases,countries,identifiers,sanctions,program_ids,dataset"
  },
  "url": "https://data.opensanctions.org/datasets/latest/ae_local_terrorists/targets.simple.csv",
  "validation": {
    "min_records": 50,
    "required_fields": [
      "name"
    ],
    "max_empty_name_pct": 10,
    "allow_digit_only_names": true
  },
  "resilience": {
    "retries": 3,
    "retry_delay_seconds": 5,
    "timeout_seconds": 180,
    "snapshot_raw": true
  }
}
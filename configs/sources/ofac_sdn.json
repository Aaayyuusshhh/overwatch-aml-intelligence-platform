{
  "source_id": "ofac_sdn",
  "agency": "Office of Foreign Assets Control (OFAC)",
  "list_name": "Specially Designated Nationals (SDN) List",
  "country": "US",
  "engine": "file_download",
  "url": "https://www.treasury.gov/ofac/downloads/sdn.csv",
  "format": "csv",
  "encoding": "latin-1",
  "delimiter": ",",
  "has_header": false,
  "field_map": {
    "name": "1",
    "details": "2,3,4,5",
    "address": "9,10,11"
